generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model routes {
  id               String   @id
  route_id         String
  year             Int
  ghg_intensity    Float
  is_baseline      Boolean  @default(false)
  fuel_consumption Float
  distance         Float
  total_emissions  Float
  vessel_type      String
  fuel_type        String
}

model ship_compliance {
  id        String @id
  ship_id   String
  year      Int
  cb_gco2eq Float

  @@unique([ship_id, year])
}

model bank_entries {
  id            String @id
  ship_id       String
  year          Int
  amount_gco2eq Float
  type          String
}

model pools {
  id         String         @id
  year       Int
  created_at DateTime       @default(now())
  members    pool_members[]
}

model pool_members {
  pool_id   String
  ship_id   String
  cb_before Float
  cb_after  Float
  
  pool      pools  @relation(fields: [pool_id], references: [id])

  @@id([pool_id, ship_id])
}
